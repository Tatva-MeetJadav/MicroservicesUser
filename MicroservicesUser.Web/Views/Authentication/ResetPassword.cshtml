@{
    ViewData["Title"] = "Reset Password";
    Layout = "_AuthLayout";
}
@model ResetPasswordVM
<link rel="stylesheet" href="~/css/authentication.css" asp-append-version="true">

<div class="container d-flex flex-column justify-content-center vh-100">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title auth-page-title text-center mb-4">Reset Password</h3>
                    <form asp-action="ResetPassword" method="post">
                        <input asp-for="Token" type="hidden" class="password-reset-token">
                        <div class="mb-3">
                            <label class="form-label">New Password</label>
                            <input class="form-control" type="password" asp-for="NewPassword" />
                            <span class="text-danger" asp-validation-for="NewPassword"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input class="form-control" type="password" asp-for="ConfirmPassword" />
                            <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-primary w-100">Reset password</button>
                        </div>
                        <div>
                            <div class="my-3 text-center">
                                <a asp-action="Login">Back to login</a>
                            </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            var urlParams = new URLSearchParams(window.location.search);
            var token = urlParams.get('token');
            $('.password-reset-token').val(token);
        });
    </script>
}
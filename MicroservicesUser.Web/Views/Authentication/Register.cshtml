@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

@model RegisterVM;
<link rel="stylesheet" href="~/css/authentication.css" asp-append-version="true">

<div class="container d-flex flex-column justify-content-center vh-100">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title auth-page-title text-center mb-4">User Registration </h3>
                    <form asp-action="Register" asp-controller="Authentication" method="post">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input class="form-control" asp-for="Email" type="email" />
                            <span class="text-danger" asp-validation-for="Email"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input class="form-control" type="text" asp-for="Username" />
                            <span class="text-danger" asp-validation-for="Username"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Password</label>
                            <input class="form-control" type="password" asp-for="Password" />
                            <span class="text-danger" asp-validation-for="Password"></span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input class="form-control" type="password" asp-for="ConfirmPassword" />
                            <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-primary w-100">Register</button>
                        </div>
                        <div class="my-3 text-center">
                            <a asp-action="Login">Back to login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
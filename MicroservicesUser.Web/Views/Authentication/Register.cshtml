@{
    ViewData["Title"] = "Register";
    Layout = "_AuthLayout";
}

@model RegisterVM
<link rel="stylesheet" href="~/css/authentication.css" asp-append-version="true">

<div class="container d-flex flex-column justify-content-center vh-100">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="text-center mb-2">
                        <img src="~/images/logo/new-logo.png" alt="App Logo" class="img-logo" />
                    </div>
                    <h3 class="card-title auth-page-title text-center mb-2">User Registration </h3>
                    <form asp-action="Register" asp-controller="Authentication" method="post">
                        <div class="row">
                            <div class="col-12 mb-3">
                                <label class="form-label">Email</label>
                                <input class="form-control" asp-for="Email" type="text" />
                                <span class="text-danger" asp-validation-for="Email"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">First Name</label>
                                <input class="form-control" type="text" asp-for="FirstName" />
                                <span class="text-danger" asp-validation-for="FirstName"></span>
                            </div>
                            <div class="col-6 mb-3">
                                <label class="form-label">Last Name</label>
                                <input class="form-control" type="text" asp-for="LastName" />
                                <span class="text-danger" asp-validation-for="LastName"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Password</label>
                                <input class="form-control" type="password" asp-for="Password" />
                                <span class="text-danger" asp-validation-for="Password"></span>
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Confirm Password</label>
                                <input class="form-control" type="password" asp-for="ConfirmPassword" />
                                <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                            </div>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-primary w-100">Register</button>
                        </div>
                        <div class="mt-3 text-center">
                            <a asp-action="Login">Back to login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

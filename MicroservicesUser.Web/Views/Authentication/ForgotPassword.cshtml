@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}
<link rel="stylesheet" href="~/css/authentication.css" asp-append-version="true">
@model LoginVM

<div class="container d-flex flex-column justify-content-center vh-100">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title auth-page-title text-center mb-4">Forgot Password</h3>
                    <form asp-action="ForgotPassword" asp-controller="Authentication" method="post">
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input class="form-control" type="email" asp-for="Email" />
                            <span class="text-danger" asp-validation-for="Email"></span>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-primary w-100">Send Email</button>
                        </div>
                        <div class="my-3 text-center">
                            <a asp-action="Login">Back to login</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
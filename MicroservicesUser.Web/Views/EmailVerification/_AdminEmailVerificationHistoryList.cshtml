@using MicroservicesUser.Models.ViewModels.Dashboard

@model AdminEmailVerificationDashboardVM
@{
    int totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
    int currentPage = Model.CurrentPage;
    int startPage = Math.Max(2, currentPage - 1);
    int endPage = Math.Min(totalPages - 1, currentPage + 1);
    int serialNumber = Model.CurrentPage * Model.PageSize - Model.PageSize + 1;
}

@functions {

    public string GetFraudeScoreIcon(int? fraudScore)
    {
        return fraudScore switch
        {
            > 75 => "bi-arrow-up-circle-fill text-danger",
            > 25 => "bi-dash-circle-fill text-warning",
            <= 25 => "bi-arrow-down-circle-fill text-success",
            _ => ""
        };
    }
}

<!-- Modal -->
<div class="modal modal-xl fade view-detail-email-verification" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary fw-bold">Detailed View</h5>
                <button type="button" class="btn btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light email-verification-view-detail-body">
            </div>
        </div>
    </div>
</div>


<div class="table-responsive rounded-2 mt-2">
    <table class="table table-borderless align-middle mb-0">
        <thead class="table-primary">
            <tr>
                <th class="text-white">Sr No.</th>
                <th class="text-white">Username</th>
                <th class="text-white">User Status</th>
                <th class="text-white">Scanned Email</th>
                <th class="text-white">Scanned Status</th>
                <th class="text-white">Fraud score</th>
                <th class="text-white">Valid</th>
                <th class="text-white">View Detail</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.EmailVerificationHistoryList!.Any())
            {
                foreach (var item in Model.EmailVerificationHistoryList!)
                {
                    <tr class="border-bottom">
                        <td class="text-secondary">@serialNumber</td>
                        <td class="text-secondary">@item.Username</td>
                        <td class="text-secondary">@item.UserStatus</td>
                        <td class="text-secondary">@item.VerifiedEmail</td>
                        <td class="text-secondary">@item.ScannedStatus</td>
                        <td class="text-secondary">
                            <div class="d-flex justify-content-center">
                                <div class="px-2 py-1 rounded-2 d-flex align-items-center gap-2">
                                    @if (item.ScannedStatus == "Success")
                                    {
                                        <span>@item.FraudScore</span>
                                        <i class="@GetFraudeScoreIcon(item.FraudScore)"></i>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td class="text-secondary">
                            @if (item.ScannedStatus == "Success")
                            {
                                @item.Valid
                            }
                            else
                            {
                                <span>Unknown</span>
                            }
                        </td>
                        <td class="text-secondary">
                            <div class="text-center">
                                @if (item.ScannedStatus == "Success")
                                {
                                    <button class="btn-view view-detail-eye">
                                        <i class="fas fa-eye" role="button"></i>
                                        <input type="hidden" value="@item.Id">
                                    </button>

                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </div>
                        </td>
                    </tr>
                    serialNumber++;
                }
            }
            else
            {
                <tr class="border-bottom">
                    <td colspan="8" class="text-center">No records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-2 bg-white @(Model.TotalItems == 0 ? "d-none" : "")">
    <div class="d-flex flex-sm-row flex-column justify-content-between gap-2 align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div><span>Items Per Page</span></div>
            <div>
                <select class="form-select items-per-page form-select-sm">
                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="me-2 pagination-info" data-current-page="@currentPage">
                Showing @((currentPage - 1) * Model.PageSize + 1)-@((currentPage - 1) * Model.PageSize
                                + Model.EmailVerificationHistoryList!.Count)
                of
                @Model.TotalItems
            </span>
            <button class="btn prev-page btn-primary @(currentPage == 1 ? "disabled" : "")">
                <i class="bi bi-chevron-left"></i>
                <span>Previous</span>
            </button>

            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination mb-0">
                        <li class="page-item @(currentPage == 1 ? "active" : "")">
                            <button class="page-link page-index" data-page="1">1</button>
                        </li>

                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <button class="page-link page-index" data-page="@i">@i</button>
                            </li>
                        }

                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        <li class="page-item @(currentPage == totalPages ? "active" : "")">
                            <button class="page-link page-index" data-page="@totalPages">@totalPages</button>
                        </li>
                    </ul>
                </nav>
            }

            <button
                class="btn next-page btn-primary @(currentPage* Model.PageSize >= Model.TotalItems ? "disabled" : "")">
                <span>Next</span>
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

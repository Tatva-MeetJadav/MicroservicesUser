@using MicroservicesUser.Models.ViewModels.Dashboard
@using System.Text.Json
@model AdminEmailVerificationDashboardVM
@{
    List<string> labels = Model.EmailVerificationDateTimeStates!.Select(x => x.CreatedAt).ToList()!;
    List<int> scans = Model.EmailVerificationDateTimeStates!.Select(x => x.EmailVerificationCount).ToList();
}
<div class="row gy-3">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Verified Emails</div>
                    <div class="stat-number primary text-nowrap">@Model.TotalEmailVerifications</div>
                </div>
                <div class="stat-icon primary">
                    <i class="bi bi-rocket-takeoff-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Success Rate</div>
                    <div class="stat-number success text-nowrap">@Model.SuccessRate %</div>
                </div>
                <div class="stat-icon success">
                    <i class="fa-solid fa-award d-flex text-center"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Valid Emails</div>
                    <div class="stat-number info text-nowrap">@Model.ValidEmails</div>
                </div>
                <div class="stat-icon info">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Average Fraud Score</div>
                    <div class="stat-number warning text-nowrap">@Model.AverageFraudScore %</div>
                </div>
                <div class="stat-icon warning">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-7">
        <div class="bg-white p-2 rounded-2 shadow-sm h-100">
            <div class="d-flex gap-1 align-items-center mt-1 mb-3 ps-1">
                <i class="bi bi-hourglass fs-5 fw-bold"></i>
                <h5 class="mb-0 fw-bold ">Email Verification History List</h5>
            </div>
            <div class="row justify-content-end align-items-center mt-3">
                <div class="col-md-6 col-xxl-4 fw-semibold">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control search-query"
                            placeholder="Enter the username or scanned email for search..."
                            name="searchQueryForHistory">
                    </div>

                </div>
                <div class="col-md-3 col-xxl-3 fw-semibold">
                    <select class="form-select scanned-status-filter" role="button">
                        <option value="" selected hidden>Scanned Status</option>
                        <option value="">All</option>
                        <option value="Success">Success</option>
                        <option value="Failed">Failed</option>
                    </select>
                </div>
                <div class="col-md-3 col-xxl-3 fw-semibold">
                    <select class="form-select valid-filter" role="button">
                        <option value="" selected hidden>Valid</option>
                        <option value="">All</option>
                        <option value="True">True</option>
                        <option value="False">False</option>
                    </select>
                </div>
            </div>
            <div class="email-verification-history-list">
                @await Html.PartialAsync("_AdminEmailVerificationHistoryList")
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="bg-white p-3 rounded-2 shadow-sm h-100 d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0 fw-bold">Verification Trends</h5>
                <div class="chart-header d-flex align-items-center justify-content-between">
                    <select class="form-select form-select-sm w-auto chart-time-filter border-dark-subtle"
                        role="button">
                        <option value="today">Today</option>
                        <option value="currentMonth">Current Month</option>
                        <option value="monthly">Monthly</option>
                        <option value="yearly">Yearly(Last 5 years)</option>
                    </select>
                </div>
            </div>

            <canvas id="verificationLineChart" class="h-100" data-labels='@Html.Raw(JsonSerializer.Serialize(labels))'
                data-scans='@Html.Raw(JsonSerializer.Serialize(scans))'></canvas>
        </div>
    </div>
</div>

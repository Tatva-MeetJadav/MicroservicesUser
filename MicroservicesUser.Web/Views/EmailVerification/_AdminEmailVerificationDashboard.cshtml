@using MicroservicesUser.Models.ViewModels.Dashboard
@using System.Text.Json
@model AdminEmailVerificationDashboardVM
@{
    List<string> labels = Model.EmailVerificationDateTimeStates!.Select(x => x.CreatedAt).ToList()!;
    List<int> scans = Model.EmailVerificationDateTimeStates!.Select(x => x.EmailVerificationCount).ToList();
}
<div class="row gy-3">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Verified Emails</div>
                    <div class="stat-number primary text-nowrap">@Model.TotalEmailVerifications</div>
                </div>
                <div class="stat-icon primary">
                    <i class="bi bi-rocket-takeoff-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Success Rate</div>
                    <div class="stat-number success text-nowrap">@Model.SuccessRate %</div>
                </div>
                <div class="stat-icon success">
                    <i class="fa-solid fa-award d-flex text-center"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Valid Emails</div>
                    <div class="stat-number info text-nowrap">@Model.ValidEmails</div>
                </div>
                <div class="stat-icon info">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Average Fraud Score</div>
                    <div class="stat-number warning text-nowrap">@Model.AverageFraudScore %</div>
                </div>
                <div class="stat-icon warning">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-7">
        <div class="bg-white p-2 rounded-2 shadow-sm h-100">
            <div class="d-flex gap-1 align-items-center mt-1 mb-3 ps-1">
                <i class="bi bi-hourglass fs-5 fw-bold"></i>
                <h5 class="mb-0 fw-bold ">Email Verification History List</h5>
            </div>
            <div class="email-verification-history-list">
                @await Html.PartialAsync("_AdminEmailVerificationHistoryList")
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-5">
        <div class="bg-white p-3 rounded-2 shadow-sm h-100 d-flex flex-column">
            <h5 class="mb-3 fw-bold">Verification Trends</h5>
            <canvas id="verificationLineChart" class="h-100" data-labels='@Html.Raw(JsonSerializer.Serialize(labels))'
                data-scans='@Html.Raw(JsonSerializer.Serialize(scans))'></canvas>
        </div>
    </div>
</div>

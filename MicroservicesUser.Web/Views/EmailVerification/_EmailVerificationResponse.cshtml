@using MicroservicesUser.Models.ViewModels.EmailVerification
@model EmailVerificationResponseVM

@{
    // Helper for status icons
    Func<bool?, string> statusIcon = status => status == true
    ? "<i class='bi bi-check-circle-fill text-success'></i>"
    : status == false
    ? "<i class='bi bi-x-circle-fill text-danger'></i>"
    : "<i class='bi bi-question-circle-fill text-secondary'></i>";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-5 mb-3">
            <div class="card shadow-sm bg-light">
                <div class="card-header fw-bold fs-5 bg-primary text-white">
                    Email Verification Status
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Is Valid Email?
                            <span>@Html.Raw(statusIcon(Model.Valid))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Timed Out?
                            <span>@Html.Raw(statusIcon(Model.TimedOut))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Is Disposable Email?
                            <span>@Html.Raw(statusIcon(Model.Disposable))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Is Generic?
                            <span>@Html.Raw(statusIcon(Model.Generic))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Is Common Domain?
                            <span>@Html.Raw(statusIcon(Model.Common))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Is Catch-all Domain?
                            <span>@Html.Raw(statusIcon(Model.CatchAll))</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            SMTP Score
                            <span>@Model.SmtpScore</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Overall Score
                            <span>@Model.OverallScore</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Deliverability
                            <span>@Model.Deliverability</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Fraud Score
                            <span>@Model.FraudScore</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between">
                            Spam Trap Score
                            <span>@Model.SpamTrapScore</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-7 mb-3">
            <div class="card shadow-sm bg-light">
                <div class="card-header fw-bold fs-5 bg-primary text-white">
                    Email Details
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-5">Sanitized Email</dt>
                        <dd class="col-sm-7">@Model.SanitizedEmail</dd>

                        <dt class="col-sm-5">Suggested Domain</dt>
                        <dd class="col-sm-7">@Model.SuggestedDomain</dd>

                        <dt class="col-sm-5">First Name</dt>
                        <dd class="col-sm-7">@Model.FirstName</dd>

                        <dt class="col-sm-5">SPF Record</dt>
                        <dd class="col-sm-7">@Model.SpfRecord</dd>

                        <dt class="col-sm-5">DMARC Record</dt>
                        <dd class="col-sm-7">@Model.DmarcRecord</dd>

                        <dt class="col-sm-5">MX Records</dt>
                        <dd class="col-sm-7">
                            @if (Model.MxRecords != null)
                            {
                                <ul class="mb-0">
                                    @foreach (var mx in Model.MxRecords)
                                    {
                                        <li>@mx</li>
                                    }
                                </ul>
                            }
                        </dd>

                        <dt class="col-sm-5">A Records</dt>
                        <dd class="col-sm-7">
                            @if (Model.ARecords != null)
                            {
                                <ul class="mb-0">
                                    @foreach (var a in Model.ARecords)
                                    {
                                        <li>@a</li>
                                    }
                                </ul>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Tertiary Details: Timeline -->
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card bg-light shadow-sm">
                <div class="card-header bg-info text-white">First Seen</div>
                <div class="card-body">
                    <p>Human: @Model.FirstSeen?.Human</p>
                    <p>ISO: @Model.FirstSeen?.Iso</p>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="card bg-light shadow-sm">
                <div class="card-header bg-info text-white">Domain Age</div>
                <div class="card-body">
                    <p>Human: @Model.DomainAge?.Human</p>
                    <p>ISO: @Model.DomainAge?.Iso</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Security & Risk Info -->
    <div class="row">
        <div class="col-md-12 mb-3">
            <div class="card bg-light shadow-sm">
                <div class="card-header bg-danger text-white">Security & Risk</div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">DNS Valid</dt>
                        <dd class="col-sm-8">@Html.Raw(statusIcon(Model.DnsValid))</dd>

                        <dt class="col-sm-4">Honeypot</dt>
                        <dd class="col-sm-8">@Html.Raw(statusIcon(Model.Honeypot))</dd>

                        <dt class="col-sm-4">Frequent Complainer</dt>
                        <dd class="col-sm-8">@Html.Raw(statusIcon(Model.FrequentComplainer))</dd>

                        <dt class="col-sm-4">Suspect</dt>
                        <dd class="col-sm-8">@Html.Raw(statusIcon(Model.Suspect))</dd>

                        <dt class="col-sm-4">Recent Abuse</dt>
                        <dd class="col-sm-8">@Html.Raw(statusIcon(Model.RecentAbuse))</dd>

                        <dt class="col-sm-4">Leaked</dt>
                        <dd class="col-sm-8">@Html.Raw(statusIcon(Model.Leaked))</dd>

                        <dt class="col-sm-4">Risky TLD</dt>
                        <dd class="col-sm-8">@Html.Raw(statusIcon(Model.RiskyTld))</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

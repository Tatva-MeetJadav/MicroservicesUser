@{
    int totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
    int currentPage = Model.CurrentPage;
    int startPage = Math.Max(2, currentPage - 1);
    int endPage = Math.Min(totalPages - 1, currentPage + 1);
    int serialNumber = Model.CurrentPage * Model.PageSize - Model.PageSize + 1;
}
@model UserListVM

<div class="users-card">
    <table class="users-table table">
        <thead>
            <tr>
                <th>User</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users != null)
            {
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>
                            <div class="user-info">
                                @if (!string.IsNullOrEmpty(user.ProfilePhotoGeneratedName))
                                {
                                    <img src="~/images/profile/@user.ProfilePhotoGeneratedName" class="user-avatar" />
                                }
                                else
                                {
                                    <img src="~/images/profile/default.jpg" class="user-avatar" />
                                }

                                <div class="user-details">
                                    <h6>@user.FirstName @user.LastName</h6>
                                </div>
                            </div>
                        </td>
                        <td>@user.Email</td>
                        <td>
                            @if (!string.IsNullOrEmpty(user.MobileNumber))
                            {
                                @user.MobileNumber
                            }
                            else
                            {
                                <i class="bi bi-dash-lg"></i>
                            }

                        </td>
                        <td>
                            <span class="status-badge status-active">
                                Active
                            </span>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <button class="action-btn btn-view" title="View User">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button class="action-btn btn-unblock" title="Unblock User">
                                    <i class="fas fa-unlock"></i>
                                </button>
                                <button class="action-btn btn-delete" title="Delete User">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<div class="my-2 p-2 bg-white @(Model.TotalItems == 0 ? "d-none" : "")">
    <div class="d-flex flex-sm-row flex-column justify-content-between gap-2 align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div>
                <span>Items Per Page</span>
            </div>
            <div>
                <select class="form-select items-per-page form-select-sm" data-pagination-info="@Model.Users?.Count()">
                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="me-2 pagination-info" data-current-page="@Model.CurrentPage">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)-@((Model.CurrentPage - 1) *
                                Model.PageSize
                                + Model.Users?.Count()) of @Model.TotalItems
            </span>
            <button class="btn prev-page btn-primary @(Model.CurrentPage == 1 ? "disabled" : "")">
                <i class="bi bi-chevron-left"></i>
                <span>Previous</span>
            </button>
            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination mb-0">

                        <li class="page-item @(currentPage == 1 ? "active" : "")">
                            <button class="page-link page-index" data-page="1">1</button>
                        </li>


                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <button class="page-link page-index" data-page="@i">@i</button>
                            </li>
                        }

                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        @if (totalPages > 1)
                        {
                            <li class="page-item @(currentPage == totalPages ? "active" : "")">
                                <button class="page-link page-index" data-page="@totalPages">@totalPages</button>
                            </li>
                        }
                    </ul>
                </nav>
            }

            <button
                class="btn next-page btn-primary @(Model.CurrentPage* Model.PageSize >= Model.TotalItems ? "disabled" : "")">
                <span>Next</span>
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>
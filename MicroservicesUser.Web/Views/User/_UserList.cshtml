@using Microsoft.AspNetCore.Html
@{
    int totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
    int currentPage = Model.CurrentPage;
    int startPage = Math.Max(2, currentPage - 1);
    int endPage = Math.Min(totalPages - 1, currentPage + 1);
    int serialNumber = Model.CurrentPage * Model.PageSize - Model.PageSize + 1;
}
@model UserListVM
@{
    Func<string, IHtmlContent> sortArrow = column =>
    {
        if (Model.ColumnNameForSorting != column)
        {
            return HtmlString.Empty;
        }
        else if (Model.OrderOfSorting == "asc")
        {
            return new HtmlString("<i class='bi bi-caret-up-fill ms-1'></i>");
        }
        else
        {
            return new HtmlString("<i class='bi bi-caret-down-fill ms-1'></i>");
        }
    };
}

<div class="modal fade" id="userDetailsModal" tabindex="-1" aria-labelledby="userDetailsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary fw-bold" id="userDetailsModalLabel">User Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="user-profile-section bg-light">
                    <img id="modalUserAvatar"
                        src="~/images/profile/adf99991-86c8-4955-9ad8-7c9eec7fbb0c_pesto-shrimp-pasta-4.jpg"
                        alt="User Avatar" class="user-profile-avatar">
                    <div id="modalUserFullName" class="user-profile-name"></div>
                    <span id="modalUserStatus" class="user-profile-status online"></span>
                </div>
                <div class="user-info-section">
                    <div class="info-item">
                        <div class="info-label">Email</div>
                        <div id="modalUserEmail" class="info-value"></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Username</div>
                        <div id="modalUserName" class="pb-2"></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Phone Number</div>
                        <div id="modalUserPhone" class="info-value"></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Address</div>
                        <div id="modalUserAddress" class="info-value"></div>
                    </div>
                    <div class="info-item">
                        <div class="info-label">Join Date</div>
                        <div id="modalUserJoinDate" class="info-value"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="blockUserModal" tabindex="-1" aria-labelledby="blockUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary fw-bold" id="blockUserModalLabel">Block User Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to block this user? Once blocked, the user will no longer have access to their
                    account.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-confirm-lock" id="confirmBlockUserBtn">Block User</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="unblockUserModal" tabindex="-1" aria-labelledby="unblockUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary fw-bold" id="unblockUserModalLabel">Unblock User Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to Unblock this user? Once Unblocked, the user will gain access to
                    their account.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-confirm-unlock" id="confirmBlockUserBtn">Unblock User</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary fw-bold" id="deleteUserModalLabel">Delete User Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this user?
                </p>
                <p><strong class="text-warning">This action can't be reverted!</strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteUserBtn">Delete User</button>
            </div>
        </div>
    </div>
</div>


<div class="users-card table-responsive">
    <table class="users-table table">
        <thead>
            <tr>
                <th class="text-white text-nowrap sort-filter" data-column="User" role="button">
                    <i class="bi bi-person"></i>
                    <span>User</span>
                    @sortArrow("User")
                </th>
                <th class="text-white text-nowrap sort-filter" data-column="Email" role="button">
                    <i class="bi bi-envelope"></i>
                    <span>Email</span>
                    @sortArrow("Email")
                </th>
                <th class="text-nowrap">
                    <i class="bi bi-telephone"></i>
                    <span>Phone</span>
                    @sortArrow("Phone")
                </th>
                <th class="text-white text-nowrap sort-filter" data-column="CreatedAt" role="button">
                    <i class="bi bi-calendar3"></i>
                    <span>Joining Date</span>
                    @sortArrow("CreatedAt")
                </th>
                <th class="text-white text-nowrap sort-filter" data-column="Status" role="button">
                    <i class="bi bi-info-circle"></i>
                    <span>Status</span>
                    @sortArrow("Status")
                </th>
                <th>
                    <i class="bi bi-gear"></i>
                    <span>Actions</span>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Users != null && Model.Users.Count != 0)
            {
                @foreach (UserVM user in Model.Users)
                {
                    <tr>@await Html.PartialAsync("_UserRow", user)</tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center">No records found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div
    class="my-2 p-2 border border-1 border-secondary-subtle rounded-1 bg-white @(Model.TotalItems == 0 ? "d-none" : "") shadow-sm">
    <div class="d-flex flex-sm-row flex-column justify-content-between gap-2 align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div>
                <span>Items Per Page</span>
            </div>
            <div>
                <select class="form-select items-per-page form-select-sm" data-pagination-info="@Model.Users?.Count()"
                    role="button">
                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>
        </div>
        <div class="d-flex flex-column flex-md-row gap-2 align-items-center">
            <span class="me-2 pagination-info" data-current-page="@Model.CurrentPage">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)-@((Model.CurrentPage - 1) *
                                Model.PageSize
                                + Model.Users?.Count()) of @Model.TotalItems
            </span>
            <div class="d-flex gap-2">
                <button class="btn prev-page btn-primary text-nowrap @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <i class="bi bi-chevron-left"></i>
                    <span class="d-none d-lg-inline-flex">Previous</span>
                </button>
                @if (totalPages > 1)
                {
                    <nav>
                        <ul class="pagination mb-0">

                            <li class="page-item @(currentPage == 1 ? "active" : "")">
                                <button class="page-link page-index" data-page="1">1</button>
                            </li>


                            @if (startPage > 2)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(currentPage == i ? "active" : "")">
                                    <button class="page-link page-index" data-page="@i">@i</button>
                                </li>
                            }

                            @if (endPage < totalPages - 1)
                            {
                                <li class="page-item disabled"><span class="page-link">...</span></li>
                            }

                            @if (totalPages > 1)
                            {
                                <li class="page-item @(currentPage == totalPages ? "active" : "")">
                                    <button class="page-link page-index" data-page="@totalPages">@totalPages</button>
                                </li>
                            }
                        </ul>
                    </nav>
                }

                <button
                    class="btn next-page btn-primary text-nowrap @(Model.CurrentPage* Model.PageSize >= Model.TotalItems ? "disabled" : "")">
                    <span class="d-none d-lg-inline-flex">Next</span>
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>

        </div>
    </div>
</div>
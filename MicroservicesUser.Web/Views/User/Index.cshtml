@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}
@model UserListVM
<link rel="stylesheet" href="~/css/userManagement.css" asp-append-version="true">
<div class="user-management-container">
    <div class="mb-3 page-header">
        <h1 class="page-title">User Management</h1>
        <p class="page-subtitle">Manage and monitor user accounts</p>
    </div>
    <div class="row">
        <div class="col-3 mt-3">
            <input type="text" class="form-control mb-2 search-query"
                placeholder="Enter the name or email for search..." name="searchQueryForUsers">
        </div>
    </div>
    <div class="user-list-container">
        @await Html.PartialAsync("_UserList", Model)
    </div>
</div>

@section Scripts
{
    <script src="~/js/user.js"></script>
}
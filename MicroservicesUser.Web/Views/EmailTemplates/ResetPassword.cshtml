@model ResetPasswordEmailVM
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password</title>
</head>

<body style="
      display:flex;justify-content: center;flex-direction: column;align-items:center; 
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f4f4f4;
      color: #333;
    ">
    <div style="
        width: 100%;
        margin: 40px auto;
        background-color: #ffffff;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
      ">
        <!-- Header -->
        <div style="
          background-color: teal;
          color: white;
          padding: 20px;
          text-align: center;
          font-size: 20px;
          font-weight: bold;
        ">
            Hello, Microservice User
        </div>
        <!-- Body -->
        <div style="padding: 30px 25px">
            <p style="font-size: 16px; margin-top: 0">
                We received a request to reset your account password.
            </p>
            <p style="font-size: 16px">
                Please click the button below to reset your password:
            </p>

            <!-- CTA Button -->
            <div style="text-align: center; margin: 30px 0">
                <a href="@Model.ResetLinkUrl" style="
              background-color: #00bcd4;
              color: #ffffff;
              padding: 12px 24px;
              border-radius: 5px;
              text-decoration: none;
              font-weight: bold;
              display: inline-block;
            ">
                    Reset Password
                </a>
            </div>

            <!-- Note -->
            <p style="font-size: 14px; color: #555">
                <strong style="color: red">Important Note:</strong> This link will
                expire in 1 hour. If you did not request a password reset, please
                ignore this email or contact our support immediately.
            </p>
        </div>

        <!-- Footer -->
        <div style="
          background-color: #f0f0f0;
          padding: 15px 25px;
          font-size: 12px;
          color: #888;
          text-align: center;
        ">
            © 2025 Microservices Name. All rights reserved.
        </div>
    </div>
</body>

</html>

@model ChangePasswordVM
<div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
        <form class="changePasswordForm" method="post">
            <div class="modal-header">
                <h1 class="modal-title fs-5 fw-bold">Change Password</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-column gap-2">
                    <div class="form-floating">
                        <input type="password" class="form-control" placeholder="CurrentPassword"
                            asp-for="CurrentPassword">
                        <label>Current password</label>
                        <span class="text-danger" asp-validation-for="CurrentPassword"></span>
                    </div>
                    <div class="form-floating">
                        <input type="password" class="form-control" placeholder="NewPassword" asp-for="NewPassword">
                        <label>New password</label>
                        <span class="text-danger" asp-validation-for="NewPassword"></span>
                    </div>
                    <div class="form-floating">
                        <input type="password" class="form-control" placeholder="ConfirmPassword"
                            asp-for="ConfirmPassword">
                        <label>Confirm password</label>
                        <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </form>
    </div>
</div>
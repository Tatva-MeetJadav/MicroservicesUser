@{
    string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MicroservicesUser</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/images/logo/favicon-logo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,501,401,400,300&display=swap" rel="stylesheet">
</head>

<body>
    <div class="d-flex main-container m-0 min-vh-100">
        @if (currentAction != "UserProfile")
        {
            <div class="offcanvas offcanvas-start d-md-none" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="mobileSidebarLabel">Menu</h5>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                </div>
                <div class="offcanvas-body">
                    <aside class="mt-3 px-2 d-flex flex-column gap-2">
                        <a class="px-3 py-1 sidebar-link text-start @(currentController == "Dashboard" ? "bg-primary text-white fw-bold" : "text-black") rounded-1 text-decoration-none" role="button" asp-action="Index" asp-controller="Dashboard">
                            Dashboard
                        </a>
                        <a class="px-3 py-1 sidebar-link text-start @(currentController == "EmailVerification" ? "bg-primary text-white fw-bold" : "text-black") rounded-1 text-black text-decoration-none" role="button" asp-action="Index" asp-controller="EmailVerification">
                            Email Verification
                        </a>
                        <a class="px-3 py-1 sidebar-link text-start @(currentController == "History" ? "bg-primary text-white fw-bold" : "text-black") rounded-1 text-decoration-none" role="button" asp-action="Index" asp-controller="History">
                            History
                        </a>
                    </aside>
                </div>
            </div>
            <div class="d-none d-md-block sidebar px-0 border-right">
                <div>
                    <div class="text-center pb-1 pt-3">
                        <img src="~/images/logo/new-logo.png" alt="App Logo" class="navbar-logo bg-white rounded-2" />
                    </div>
                    <aside class="mt-3 px-2 d-flex flex-column gap-2">
                        <a class="px-3 py-1 sidebar-link text-start @(currentController == "Dashboard" ? "bg-primary text-white fw-bold" : "text-black") rounded-1 text-decoration-none" role="button" asp-action="Index" asp-controller="Dashboard">
                            Dashboard
                        </a>
                        <a class="px-3 py-1 sidebar-link text-start @(currentController == "EmailVerification" ? "bg-primary text-white fw-bold" : "text-black") rounded-1 text-black text-decoration-none" role="button" asp-action="Index" asp-controller="EmailVerification">
                            Email Verification
                        </a>
                        <a class="px-3 py-1 sidebar-link text-start @(currentController == "History" ? "bg-primary text-white fw-bold" : "text-black") rounded-1 text-decoration-none" role="button" asp-action="Index" asp-controller="History">
                            History
                        </a>
                    </aside>
                </div>
            </div>
        }
        
        <div class="px-0 main-content @(currentAction == "UserProfile" ? "full-width" :"")">
            <div class="d-flex shadow-sm @(currentAction == "UserProfile" ? "justify-content-end":"justify-content-between")  align-content-center py-2 bg-primary position-sticky top-0 navbar-content">
                <button class="btn d-md-none  @(currentAction == "UserProfile" ? "d-none":"") ms-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileSidebar" aria-controls="mobileSidebar">
                    <i class="bi bi-list fs-4 text-white"></i>
                </button>
                <div class="d-none d-md-flex justify-content-center align-items-center">
                    @if (currentAction != "UserProfile")
                    {
                        <a class="sidebar-toggle ms-2" title="Toggle sidebar" role="button">
                            <i class="bi bi-list fs-4 text-white"></i>
                        </a>
                    }
                </div>
                <div class="d-flex justify-content-end align-items-center">
                    <div class="dropdown pe-3">
                        <a class="dropdown-toggle text-white text-decoration-none"
                           role="button"
                           id="dropdownMenuLink"
                           data-bs-toggle="dropdown"
                           aria-expanded="false">
                            <img src="~/images/profile/default.jpg" alt="" class="profile-image">
                        </a>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                            <li><a class="dropdown-item" asp-action="UserProfile" asp-controller="Dashboard">My Profile</a></li>
                            <li><a class="dropdown-item" data-bs-toggle="modal" data-bs-target=".changePasswordModal" role="button">Change Password</a></li>
                            @if(currentAction == "UserProfile")
                            {
                                <li><a class="dropdown-item" asp-action="Index" asp-controller="Dashboard" role="button">Go to Dashboard</a></li>
                            }
                            <li><a class="dropdown-item" data-bs-toggle="modal" data-bs-target=".logoutModal" role="button">Logout</a></li>
                        </ul>
                    </div>
                </div>
            </div>
       
            <div class="container-fluid append-container">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
    
    <div class="modal fade changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel" aria-hidden="true">
        @await Html.PartialAsync("_ChangePassword",new ChangePasswordVM())
    </div>
    <div class="modal fade logoutModal"  tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="Logout" asp-controller="Authentication" method="post">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5 fw-bold text-primary">Logout</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-exclamation-triangle-fill fs-2 text-primary"></i>
                            <span class="fs-5">Are you sure you want to logout?</span>
                        </div>
                    </div>
                    <div class="modal-footer pt-0 border-0 d-flex justify-content-center">
                        <button type="submit" class="btn btn-primary">Yes</button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script>
        $(document).ready(function () {
            var successMessage = '@TempData["SuccessMessage"]';
            var errorMessage = '@TempData["ErrorMessage"]';
            var warningMessage = '@TempData["WarningMessage"]';
            var infoMessage = '@TempData["InfoMessage"]';

            if (successMessage) {
                toastr.success(successMessage);
            }
            if (errorMessage) {
                toastr.error(errorMessage);
            }
            if (warningMessage) {
                toastr.warning(warningMessage);
            }
            if (infoMessage) {
                toastr.info(infoMessage);
            }
        });
    </script>
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "4000"
        };
    </script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous">
    </script>
    <script src="~/js/pophoverScript.js" asp-append-version="true"></script>
   @Html.Raw("<script src=\"https://cdn.jsdelivr.net/npm/@microsoft/signalr@7.0.14/dist/browser/signalr.min.js\"></script>")
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/comman.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>

@{
    ViewData["Title"] = "Logs";
    Layout = "_AdminLayout";
}
@model LogListVM
<link rel="stylesheet" href="~/css/logs.css" asp-append-version="true">
<div class="log-container px-1 px-md-4 mt-4">
    <div class="mb-3 page-header">
        <h1 class="page-title">Logs</h1>
        <p class="page-subtitle mt-2">Monitor logs of Microservices</p>
    </div>
    <div class="row">
        <div class="col-xxl-4 col-md-8 col-12 mt-lg-3">
            <div class="d-flex gap-2 mb-3 position-relative">
                <input type="text" class="form-control"
                    placeholder="Enter the log message or machine name for search..." name="searchQueryForLogs"
                    id="searchQueryForLogs" autocomplete="off" aria-haspopup="listbox" aria-expanded="false"
                    aria-controls="suggestionList">
                <button class="btn btn-primary search-query">Search</button>

                <ul class="dropdown-menu w-100" id="suggestionList" role="listbox"></ul>
            </div>

        </div>
        <div class="col-xxl-3 col-md-4 col-12 mt-lg-3 mb-3 mb-lg-0 fw-semibold">
            <div class="input-group">
                <span class="input-group-text">Status</span>
                <select class="form-select column-filter" role="button" data-column="Status">
                    <option value="">All</option>
                    <option value="0">Trace</option>
                    <option value="1">Debug</option>
                    <option value="2">Information</option>
                    <option value="3">Warning</option>
                    <option value="4">Error</option>
                    <option value="5">Critical</option>
                </select>
            </div>
        </div>
    </div>

    <div class="log-list-container">
        @await Html.PartialAsync("_LogList", Model)
    </div>
</div>

@section Scripts
{
    <script src="~/js/logs.js"></script>
}
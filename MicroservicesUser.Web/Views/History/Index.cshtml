@using MicroservicesUser.Models.ViewModels.History
@{
    ViewData["Title"] = "History";
}
<div class="d-flex justify-content-center mt-4">
    <div class="text-primary fs-2 fw-bold">History</div>
</div>
<link rel="stylesheet" href="~/css/history.css" asp-append-version="true">
<ul class="nav nav-pills px-2">
    <li class="nav-item">
        <a class="nav-link active" aria-current="page" href="#">Email Verification</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-black">Other</a>
    </li>
</ul>
<hr>

<div class="d-flex justify-content-between align-items-center px-2">
    <div
        class="w-25 d-flex justify-content-between align-items-center border border-1 border-primary px-2 py-1 bg-white rounded-2">
        <input class="form-control search-query border-0" name="searchQueryForHistory" placeholder="Search">
        <i class="bi bi-search"></i>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="mt-1 fw-bold text-primary">Is valid?</span>
        <div class="form-check form-switch">
            <input class="form-check-input valid-email-history-switch" title="Turn on to see only valid emails"
                type="checkbox" role="switch">
        </div>
    </div>

</div>


<div class="load-history-table px-2">
</div>

@section Scripts
{
    <script src="~/js/emailVerificationHistory.js"></script>
}
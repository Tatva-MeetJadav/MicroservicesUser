@{
    Layout = "_AdminLayout";
}

@using MicroservicesUser.Models.ViewModels.Dashboard

@model ProxyVpnDetectionDashboardVM
<link rel="stylesheet" href="~/css/proxyAndVpnDetection.css" asp-append-version="true">

<div class="page-header mt-4">
    <div class="d-flex px-3 justify-content-between align-items-start flex-wrap">
        <div class="mb-3 mb-md-0">
            <h1 class="page-title">Proxy And Vpn Detection Dashboard</h1>
            <p class="page-subtitle">Aggregated metrics for proxy and vpn detection service</p>
        </div>

        <div class="dropdown mt-2 mt-lg-0">
            <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown"
                aria-expanded="false">
                Select Users
            </button>
            <ul class="dropdown-menu users-dropdown-list p-2" id="dropdownMenu">
                <li>
                    <input type="text" class="form-control users-dropdown-search mb-2" id="dropdownSearch"
                        placeholder="Search...">
                </li>

                <li>
                    <div class="d-flex gap-2 px-2 align-items-center">
                        <span class="mt-1">
                            <input type="checkbox" id="selectAllUsers" role="button" checked>
                        </span>
                        <span><strong>Select All</strong></span>
                    </div>
                </li>

                <li>
                    <hr class="dropdown-divider">
                </li>
                @if (Model.DashboardUsers != null)
                {
                    @foreach (var user in Model.DashboardUsers)
                    {
                        <li>
                            <input type="hidden" asp-for="@user.UserId" class="dashboard-dropdown-user-id">
                            <div class="d-flex gap-2 px-2 align-items-center">
                                <span class="mt-1">
                                    <input type="checkbox" role="button" value="Apple" checked>
                                </span>
                                <span>
                                    @user.Email
                                </span>
                            </div>
                        </li>
                    }
                }
                <li>
                    <hr class="dropdown-divider">
                </li>
                <li><button class="btn btn-primary w-100" id="showResultBtn">Show Result</button></li>
            </ul>
        </div>
    </div>
</div>

<div class="proxy-vpn-dashboard-data">
    @await Html.PartialAsync("_ProxyVpnDetection", Model)
</div>

@section Scripts
{
    <script src="~/js/proxyVpnDetection.js"></script>
}

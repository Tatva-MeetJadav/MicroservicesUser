@using MicroservicesUser.Models.ViewModels.Dashboard
@model ProxyVpnDetectionDashboardVM
@{
    int totalPages = (int)Math.Ceiling((double)Model.TotalItems / Model.PageSize);
    int currentPage = Model.CurrentPage;
    int startPage = Math.Max(2, currentPage - 1);
    int endPage = Math.Min(totalPages - 1, currentPage + 1);
    int serialNumber = Model.CurrentPage * Model.PageSize - Model.PageSize + 1;
}

@functions {


    public string GetVpnColor(string? vpnStatus)
    {
        return vpnStatus switch
        {
            "VPN" => "bg-secondary",
            "Proxy" => "bg-secondary",
            "TOR" => "bg-secondary",
            _ => "bg-success"
        };
    }

    public string GetRiskIcon(string? riskIcon)
    {
        return riskIcon switch
        {
            "High" => "bi-arrow-up-circle-fill text-danger",
            "Medium" => "bi-dash-circle-fill text-warning",
            "Low" => "bi-arrow-down-circle-fill text-success",
            _ => "bg-success"
        };
    }
}


<div class="modal modal-xl fade view-detail-proxy-vpn-detection" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-primary fw-bold">Detailed View</h5>
                <button type="button" class="btn btn-close" data-bs-dismiss="modal" aria-label="Close">
                </button>
            </div>
            <div class="modal-body bg-light proxy-vpn-view-detail-body">
            </div>
        </div>
    </div>
</div>

<div class="table-responsive rounded-2 my-2">
    <table class="table table-borderless align-middle mb-0">
        <thead class="table-primary">
            <tr>
                <th class="text-white">Sr No.</th>
                <th class="text-white">User Email</th>
                <th class="text-white">IP Address</th>
                <th class="text-white">Risk</th>
                <th class="text-nowrap text-white">Connection Type</th>
                <th class="text-white">View Detail</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ProxyVpnDetectionHistoryList != null && Model.ProxyVpnDetectionHistoryList.Count != 0)
            {
                @foreach (ProxyVpnDetectionHistoryListVM user in Model.ProxyVpnDetectionHistoryList)
                {
                    <tr class="border-bottom">
                        <td class="text-secondary">@serialNumber</td>
                        <td class="text-secondary">@user.Email</td>
                        <td class="text-secondary">@user.IpAddress</td>
                        <td class="text-secondary">
                            <div class="d-flex justify-content-center">
                                <div class="px-2 py-1 rounded-2 d-flex align-items-center gap-2">
                                    <span>@user.RiskStatus</span>
                                    <i class="@GetRiskIcon(user.RiskStatus)"></i>
                                </div>
                            </div>
                        </td>
                        <td class="text-secondary">
                            <div class="d-flex justify-content-center">
                                <span
                                    class="@GetVpnColor(user.VPNProxyTor) px-2 py-1 text-white rounded-2">@user.VPNProxyTor</span>
                            </div>
                        </td>

                        <td class="text-secondary">
                            <div class="text-center">
                                <i class="fas fa-eye view-detail-eye btn-view p-2 rounded-2" role="button"></i>
                                <input type="hidden" asp-for="@user.Id">
                            </div>
                        </td>
                    </tr>
                    serialNumber = serialNumber + 1;
                }
            }
            else
            {
                <tr class="border-bottom">
                    <td colspan="8" class="text-center">No records found.</td>
                </tr>
            }

        </tbody>
    </table>
</div>
<div class="my-2 p-2 bg-white @(Model.TotalItems == 0 ? "d-none" : "")">
    <div class="d-flex flex-sm-row flex-column justify-content-between gap-2 align-items-center">
        <div class="d-flex align-items-center gap-2">
            <div>
                <span>Items Per Page</span>
            </div>
            <div>
                <select class="form-select items-per-page form-select-sm"
                    data-pagination-info="@Model.ProxyVpnDetectionHistoryList?.Count()">
                    <option value="5" selected="@(Model.PageSize == 5)">5</option>
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>
        </div>
        <div class="d-flex gap-2 align-items-center">
            <span class="me-2 pagination-info" data-current-page="@Model.CurrentPage">
                Showing @((Model.CurrentPage - 1) * Model.PageSize + 1)-@((Model.CurrentPage - 1) *
                                Model.PageSize
                                + Model.ProxyVpnDetectionHistoryList?.Count()) of @Model.TotalItems
            </span>
            <button class="btn prev-page btn-primary @(Model.CurrentPage == 1 ? "disabled" : "")">
                <i class="bi bi-chevron-left"></i>
                <span>Previous</span>
            </button>
            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination mb-0">

                        <li class="page-item @(currentPage == 1 ? "active" : "")">
                            <button class="page-link page-index" data-page="1">1</button>
                        </li>


                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(currentPage == i ? "active" : "")">
                                <button class="page-link page-index" data-page="@i">@i</button>
                            </li>
                        }

                        @if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span class="page-link">...</span></li>
                        }

                        @if (totalPages > 1)
                        {
                            <li class="page-item @(currentPage == totalPages ? "active" : "")">
                                <button class="page-link page-index" data-page="@totalPages">@totalPages</button>
                            </li>
                        }
                    </ul>
                </nav>
            }

            <button
                class="btn next-page btn-primary @(Model.CurrentPage* Model.PageSize >= Model.TotalItems ? "disabled" : "")">
                <span>Next</span>
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>
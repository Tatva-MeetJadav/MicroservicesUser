@using MicroservicesUser.Models.ViewModels.Dashboard
@model ProxyVpnDetectionDashboardVM
<div class="row gy-3">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Verified Ip Addresses</div>
                    <div class="stat-number primary">@Model.TotalIPVerifications</div>
                </div>
                <div class="stat-icon primary">
                    <i class="bi bi-rocket-takeoff-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card danger">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">High Risk Ip Addresses </div>
                    <div class="stat-number danger">@Model.HighRiskIPs</div>
                </div>
                <div class="stat-icon danger">
                    <i class="bi bi-shield-fill-exclamation"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Average Fraud Score</div>
                    <div class="stat-number warning">@Model.AverageFraudScore %</div>
                </div>
                <div class="stat-icon warning">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">VPN/Proxy/Tor Usage</div>
                    <div class="stat-number info">@Model.VPNProxyTorUsage %</div>
                </div>
                <div class="stat-icon info">
                    <i class="bi bi-house-lock-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-7">
        <div class="bg-white p-2 rounded-2 shadow-sm">
            <div class="row mb-3 justify-content-end align-items-center">
                <div class="col-md-4">
                    <label for="riskFilter" class="form-label">Search</label>
                    <input type="text" class="form-control search-query" name="searchQueryForHistory">
                </div>
                <div class="col-md-2">
                    <label for="riskFilter" class="form-label">Risk Status</label>
                    <select class="form-select risk-filter" role="button">
                        <option value="">All</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="connectionFilter" class="form-label">Connection Type</label>
                    <select class="form-select connection-filter" role="button">
                        <option value="">All</option>
                        <option value="VPN">VPN</option>
                        <option value="Proxy">Proxy</option>
                        <option value="Tor">Tor</option>
                    </select>
                </div>
            </div>

            <div class="proxy-vpn-detection-history-list">
                @await Html.PartialAsync("_ProxyVpnDetectionHistoryList", Model)
            </div>

        </div>
    </div>
</div>

@using MicroservicesUser.Models.ViewModels.Dashboard
@using System.Text.Json
@model ProxyVpnDetectionDashboardVM
<div class="row gy-3">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Verified Ip Addresses</div>
                    <div class="stat-number primary text-nowrap">@Model.TotalIPVerifications</div>
                </div>
                <div class="stat-icon primary">
                    <i class="bi bi-rocket-takeoff-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card danger">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">High Risk Ip Addresses </div>
                    <div class="stat-number danger text-nowrap">@Model.HighRiskIPs</div>
                </div>
                <div class="stat-icon danger">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Average Fraud Score</div>
                    <div class="stat-number warning text-nowrap">@Model.AverageFraudScore %</div>
                </div>
                <div class="stat-icon warning">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="stat-card info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">VPN/Proxy/Tor Usage</div>
                    <div class="stat-number info text-nowrap">@Model.VPNProxyTorUsage %</div>
                </div>
                <div class="stat-icon info">
                    <i class="bi bi-house-lock-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-7">
        <div class="bg-white p-2 rounded-2 shadow-sm h-100">
            <div class="d-flex gap-1 align-items-center mt-1 mb-2 ps-1">
                <i class="bi bi-hourglass fs-5 fw-bold"></i>
                <h5 class="mb-0 fw-bold ">Proxy and Vpn Detection history List</h5>
            </div>

            <div class="row mb-3 justify-content-end align-items-center">
                <div class="col-md-6 col-xxl-4 fw-semibold">
                    <label for="riskFilter" class="form-label">Search</label>
                    <input type="text" class="form-control search-query" placeholder="Enter the email for search..."
                        name="searchQueryForHistory">
                </div>
                <div class="col-md-3 col-xxl-3 fw-semibold">
                    <label for="riskFilter" class="form-label">Risk Status</label>
                    <select class="form-select risk-filter" role="button">
                        <option value="">All</option>
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>
                <div class="col-md-3 col-xxl-3 fw-semibold">
                    <label for="connectionFilter" class="form-label">Connection Type</label>
                    <select class="form-select connection-filter" role="button">
                        <option value="">All</option>
                        <option value="VPN">VPN</option>
                        <option value="Proxy">Proxy</option>
                        <option value="Tor">Tor</option>
                        <option value="Normal">Normal</option>
                    </select>
                </div>
            </div>

            <div class="proxy-vpn-detection-history-list">
                @await Html.PartialAsync("_ProxyVpnDetectionHistoryList", Model)
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-5">
        <div class="bg-white p-3 rounded-2 shadow-sm h-100">
            <div class="d-flex gap-2 align-items-center mb-2 ps-1">
                <i class="bi bi-pie-chart fs-5 fw-bold"></i>
                <h5 class="mb-0 fw-bold ">Continent Wise IP Distributions</h5>
            </div>
            <div id="ipStats3DPieChart"></div>
            <div data-pie-chart-data='@Html.Raw(JsonSerializer.Serialize(Model.ContinentIPStats))'
                class="pie-chart-data-container"></div>
        </div>
    </div>
</div>

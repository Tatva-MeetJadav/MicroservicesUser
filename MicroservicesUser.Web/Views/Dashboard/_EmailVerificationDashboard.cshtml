@using MicroservicesUser.Models.ViewModels.Dashboard
@using System.Text.Json
@model EmailVerificationDashboardVM
<div class="page-header">
    <div class="d-flex px-3 justify-content-start align-items-start flex-wrap">
        <div class="mb-3 mb-md-0">
            <h1 class="page-title">Email Verification Dashboard</h1>
            <p class="page-subtitle">Monitor your email verification performance</p>
        </div>
    </div>
</div>
<div class="row gy-3">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Today's Scans</div>
                    <div class="stat-number primary">@Model.TodayCount</div>
                </div>
                <div class="stat-icon primary">
                    <i class="bi bi-clock-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card success">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Success Rate</div>
                    <div class="stat-number success">@Math.Round(Model.SuccessRate, 2)%</div>
                </div>
                <div class="stat-icon success">
                    <i class="bi bi-trophy-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Scans</div>
                    <div class="stat-number warning">@Model.TotalCount</div>
                </div>
                <div class="stat-icon warning">
                    <i class="bi bi-envelope-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Valid Emails</div>
                    <div class="stat-number info">@Model.ValidCount</div>
                </div>
                <div class="stat-icon info">
                    <i class="bi bi-envelope-check-fill"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-6">
        <div class="chart-card">
            <div class="chart-header d-flex align-items-center justify-content-between">
                <div>
                    <i class="bi bi-bar-chart-fill me-2"></i>
                    Email Verification Scans
                </div>
                <select class="form-select form-select-sm w-auto chart-time-filter border-dark-subtle" role="button">
                    <option value="today">Today</option>
                    <option value="currentMonth">Current Month</option>
                    <option value="monthly">Monthly</option>
                    <option value="yearly">Yearly(Last 5 years)</option>
                </select>
            </div>
            <div class="bg-white rounded-2">
                <canvas class="email-verification-bar-chart w-100 h-100"></canvas>
            </div>
            <div class="chart-data d-none" data-labels='@Html.Raw(JsonSerializer.Serialize(Model.ChartData?.Labels))'
                data-scans='@Html.Raw(JsonSerializer.Serialize(Model.ChartData?.Scans))'>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="activity-card">
            <div class="activity-header">
                <i class="bi bi-clock-history me-2"></i>
                Last Five Scans
            </div>

            <div class="activity-list">
                @foreach (var item in Model.EmailVerificationList!)
                {
                    <div class="activity-item">
                        <div class="activity-icon @(item.ResponseStatus == "Success" ? "success" : "danger")">
                            <i
                                class="bi bi-@(item.ResponseStatus == "Success" ? "check-circle-fill" : "x-circle-fill")"></i>
                        </div>
                        <div class="activity-email">@item.Email</div>
                        <div
                            class="activity-status @(item.ResponseStatus == "Success" ? "status-success" : "status-danger")">
                            @item.ResponseStatus
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@using MicroservicesUser.Models.ViewModels.Dashboard
@model EmailVerificationDashboardVM

<style>
    .dashboard-container {
        padding: 2rem 1rem;
        background-color: #f8fafc;
        min-height: 100vh;
    }

    .page-header {
        background: white;
        border-radius: 12px;
        padding: 1.5rem 2rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        margin-bottom: 2rem;
    }

    .page-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1e293b;
        margin: 0;
    }

    .page-subtitle {
        color: #64748b;
        margin: 0;
        font-size: 1rem;
    }

    .nav-pills .nav-link {
        border-radius: 8px;
        padding: 0.75rem 1.25rem;
        font-weight: 500;
        transition: all 0.2s ease;
        margin-right: 0.5rem;
    }

    .nav-pills .nav-link.active {
        background-color: var(--primaryBackgroundColor);
        color: white;
    }

    .nav-pills .nav-link:not(.active) {
        background-color: #f8fafc;
        color: #64748b;
        border: 1px solid #e2e8f0;
    }

    .nav-pills .nav-link:not(.active):hover {
        background-color: var(--primaryBackgroundColor);
        color: white;
        border-color: var(--primaryBackgroundColor);
    }

    .modern-stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        height: 100%;
        border-left: 4px solid transparent;
        margin-bottom: 1rem;
    }

    .modern-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .modern-stat-card.primary {
        border-left-color: var(--primaryBackgroundColor);
    }

    .modern-stat-card.success {
        border-left-color: #10b981;
    }

    .modern-stat-card.warning {
        border-left-color: #f59e0b;
    }

    .modern-stat-card.info {
        border-left-color: #06b6d4;
    }

    .modern-stat-number {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        margin-bottom: 0.5rem;
    }

    .modern-stat-number.primary {
        color: var(--primaryBackgroundColor);
    }

    .modern-stat-number.success {
        color: #10b981;
    }

    .modern-stat-number.warning {
        color: #f59e0b;
    }

    .modern-stat-number.info {
        color: #06b6d4;
    }

    .modern-stat-label {
        font-size: 0.875rem;
        font-weight: 500;
        color: #64748b;
        margin-bottom: 1rem;
    }

    .modern-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: white;
    }

    .modern-stat-icon.primary {
        background-color: var(--primaryBackgroundColor);
    }

    .modern-stat-icon.success {
        background-color: #10b981;
    }

    .modern-stat-icon.warning {
        background-color: #f59e0b;
    }

    .modern-stat-icon.info {
        background-color: #06b6d4;
    }

    .modern-chart-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        height: 100%;
        margin-bottom: 1rem;
    }

    .modern-chart-header {
        font-size: 1.125rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
    }

    .modern-activity-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        height: 100%;
        margin-bottom: 1rem;
    }

    .modern-activity-header {
        font-size: 1.125rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
    }

    .modern-activity-item {
        display: flex;
        align-items: center;
        padding: 0.75rem 0;
        border-bottom: 1px solid #e2e8f0;
    }

    .modern-activity-item:last-child {
        border-bottom: none;
    }

    .modern-activity-icon {
        width: 32px;
        height: 32px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.75rem;
        font-size: 0.875rem;
    }

    .modern-activity-icon.success {
        background-color: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }

    .modern-activity-icon.danger {
        background-color: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

    .modern-activity-email {
        flex: 1;
        font-weight: 500;
        color: #1e293b;
    }

    .modern-activity-status {
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        text-transform: uppercase;
        letter-spacing: 0.025em;
    }

    .modern-status-success {
        background-color: rgba(16, 185, 129, 0.1);
        color: #10b981;
    }

    .modern-status-danger {
        background-color: rgba(239, 68, 68, 0.1);
        color: #ef4444;
    }

    .trend-indicator {
        font-size: 0.875rem;
        font-weight: 500;
        color: #10b981;
    }

    .chart-placeholder {
        height: 250px;
        background-color: #f8fafc;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #64748b;
        border: 2px dashed #e2e8f0;
    }
</style>

<div class="dashboard-container">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-start flex-wrap">
            <div class="mb-3 mb-md-0">
                <h1 class="page-title">Email Verification Dashboard</h1>
                <p class="page-subtitle">Monitor your email verification performance</p>
            </div>
            <ul class="nav nav-pills">
                <li class="nav-item">
                    <a class="nav-link active" href="#">Dashboard</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">Analytics</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="modern-stat-card primary">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="modern-stat-label">Today's Scans</div>
                        <div class="modern-stat-number primary">@Model.TodayCount</div>
                        <div class="trend-indicator">
                            <i class="bi bi-arrow-up"></i> Active today
                        </div>
                    </div>
                    <div class="modern-stat-icon primary">
                        <i class="bi bi-clock-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="modern-stat-card success">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="modern-stat-label">Success Rate</div>
                        <div class="modern-stat-number success">@Math.Round(Model.SuccessRate, 2)%</div>
                        <div class="trend-indicator">
                            <i class="bi bi-arrow-up"></i> Excellent rate
                        </div>
                    </div>
                    <div class="modern-stat-icon success">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="modern-stat-card warning">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="modern-stat-label">Total Scans</div>
                        <div class="modern-stat-number warning">@Model.TotalCount</div>
                        <div class="trend-indicator">
                            <i class="bi bi-arrow-up"></i> All time
                        </div>
                    </div>
                    <div class="modern-stat-icon warning">
                        <i class="bi bi-envelope-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="modern-stat-card info">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="modern-stat-label">Valid Emails</div>
                        <div class="modern-stat-number info">@Model.ValidCount</div>
                        <div class="trend-indicator">
                            <i class="bi bi-arrow-up"></i> Verified count
                        </div>
                    </div>
                    <div class="modern-stat-icon info">
                        <i class="bi bi-envelope-check-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="modern-chart-card">
                <div class="modern-chart-header">
                    <i class="bi bi-bar-chart-fill me-2"></i>
                    Email Verification Trends
                </div>
                <div class="chart-placeholder">
                    <canvas class="email-verification-bar-chart w-100 h-100"></canvas>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="modern-activity-card">
                <div class="modern-activity-header">
                    <i class="bi bi-clock-history me-2"></i>
                    Last Five Scans
                </div>

                <div class="modern-activity-list">
                    @foreach (var item in Model.EmailVerificationList!)
                    {
                        <div class="modern-activity-item">
                            <div class="modern-activity-icon @(item.ResponseStatus == "Success" ? "success" : "danger")">
                                <i
                                    class="bi bi-@(item.ResponseStatus == "Success" ? "check-circle-fill" : "x-circle-fill")"></i>
                            </div>
                            <div class="modern-activity-email">@item.Email</div>
                            <div
                                class="modern-activity-status @(item.ResponseStatus == "Success" ? "modern-status-success" : "modern-status-danger")">
                                @item.ResponseStatus
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Simple tab switching functionality
    document.querySelectorAll('.nav-link').forEach(link => {
        link.addEventListener('click', function (e) {
            e.preventDefault();

            // Remove active class from all links
            document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));

            // Add active class to clicked link
            this.classList.add('active');
        });
    });
</script>
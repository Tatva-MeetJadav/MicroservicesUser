@{
    Layout = "_AdminLayout";
}

@using MicroservicesUser.Models.ViewModels.Dashboard
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true">

<div class="admin-dashboard-container px-1 px-md-4 mt-4">
    <div class="mb-3 page-header">
        <h1 class="page-title">Dashboard</h1>
        <p class="page-subtitle mt-2">Aggregated metrics of all services</p>
    </div>
    <div class="row gy-3">
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card primary">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Total User Registrations</div>
                        <div class="stat-number primary">50</div>
                    </div>
                    <div class="stat-icon primary">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card danger">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Total Email Verifications</div>
                        <div class="stat-number danger">15</div>
                    </div>
                    <div class="stat-icon danger">
                        <i class="bi bi-shield-fill-exclamation"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card warning">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Total Ip Verifications</div>
                        <div class="stat-number warning">25%</div>
                    </div>
                    <div class="stat-icon warning">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <div class="stat-card info">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="stat-label">Total HelpDesk Requests</div>
                        <div class="stat-number info">40%</div>
                    </div>
                    <div class="stat-icon info">
                        <i class="bi bi-house-lock-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

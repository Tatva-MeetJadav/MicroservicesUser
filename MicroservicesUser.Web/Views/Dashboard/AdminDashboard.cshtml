@{
    Layout = "_AdminLayout";
}

@using MicroservicesUser.Models.ViewModels.Dashboard
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true">


<div class="page-header mt-4">
    <div class="d-flex px-3 justify-content-between align-items-start flex-wrap">
        <div class="mb-3 mb-md-0">
            <h1 class="page-title">General Dashboard</h1>
            <p class="page-subtitle">Aggregated metrics for all services</p>
        </div>

        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown"
                aria-expanded="false">
                Select Users
            </button>
            <ul class="dropdown-menu users-dropdown-list p-2" id="dropdownMenu">
                <li>
                    <input type="text" class="form-control users-dropdown-search mb-2" id="dropdownSearch"
                        placeholder="Search...">
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
                <li>
                    <div class="d-flex gap-2 px-2 align-items-center">
                        <span class="mt-1">
                            <input type="checkbox" role="button" value="Apple">
                        </span>
                        <span>
                            Apple
                        </span>
                    </div>
                </li>
                <li>
                    <div class="d-flex gap-2 px-2 align-items-center">
                        <span class="mt-1">
                            <input type="checkbox" role="button" value="Apple">
                        </span>
                        <span>
                            Apple
                        </span>
                    </div>
                </li>
                <li>
                    <div class="d-flex gap-2 px-2 align-items-center">
                        <span class="mt-1">
                            <input type="checkbox" role="button" value="Apple">
                        </span>
                        <span>
                            Apple
                        </span>
                    </div>
                </li>
                <li>
                    <hr class="dropdown-divider">
                </li>
                <li><button class="btn btn-success w-100" id="showResultBtn">Show Result</button></li>
            </ul>
        </div>
    </div>
</div>
<div class="row gy-3">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card primary">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total User Registrations</div>
                    <div class="stat-number primary">50</div>
                </div>
                <div class="stat-icon primary">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card danger">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Email Validations</div>
                    <div class="stat-number danger">15</div>
                </div>
                <div class="stat-icon danger">
                    <i class="bi bi-shield-fill-exclamation"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card warning">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Average Fraud Score</div>
                    <div class="stat-number warning">25%</div>
                </div>
                <div class="stat-icon warning">
                    <i class="bi bi-bar-chart-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card info">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">VPN/Proxy/Tor Usage</div>
                    <div class="stat-number info">40%</div>
                </div>
                <div class="stat-icon info">
                    <i class="bi bi-house-lock-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>
